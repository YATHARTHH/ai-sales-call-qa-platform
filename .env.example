# ==============================================================================
# SalesCall QA Platform — Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env)
# ==============================================================================

# Application
APP_NAME=SalesCall QA
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=dev-insecure-secret-key-change-in-production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=salescall_qa
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salescall_qa
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (Queue / Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-Compatible Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_RECORDINGS=sales-call-recordings
MINIO_BUCKET_ARTIFACTS=sales-call-artifacts

# Worker & Recovery
WORKER_CONCURRENCY=4
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_LEASE_DURATION_SECONDS=60
MAX_JOB_RETRIES=3

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
PROMETHEUS_METRICS_ENABLED=true
